    "demon_castle": {
      "name": "魔王城",
      "description": "远处黑云盘旋的高塔……",
      "npcs": ["demon_king"],
      "tags": ["endgame"]
    }
  },
  "npcs": {
    "blacksmith": { ... },
    "priest": { ... },
    "demon_king": { ... }
  }
}
```

